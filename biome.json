{
  "files": {
    "includes": ["**", "!**/node_modules", "!**/dist", "!**/bundles"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noAssignInExpressions": "off",
        "noExplicitAny": "off",
        "useIterableCallbackReturn": "off"
      },
      "style": {
        "useSingleVarDeclarator": "off",
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      }
    }
  }
}
