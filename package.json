{
  "name": "@fimbul-works/finna",
  "description": "An ultra-lightweight, modular, and type-safe pattern matching engine and predicate compiler for JavaScript and TypeScript.",
  "version": "1.0.1",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "FimbulWorks <contact@fimbul.works>",
  "homepage": "https://github.com/fimbul-works/finna#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fimbul-works/finna.git"
  },
  "bugs": {
    "url": "https://github.com/fimbul-works/finna/issues"
  },
  "keywords": [
    "finna",
    "matcher",
    "pattern-matching",
    "predicate",
    "ast-matcher",
    "query",
    "query-engine",
    "filter",
    "mongodb",
    "json-query",
    "compiler",
    "operators",
    "typescript",
    "tree-shakable"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./core": {
      "types": "./dist/esm/index.core.d.ts",
      "import": "./dist/esm/index.core.js",
      "require": "./dist/cjs/index.core.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "finna-logo.svg"
  ],
  "sideEffects": true,
  "scripts": {
    "clean": "rm -rf dist",
    "clean:bundles": "rm -rf bundles",
    "build": "pnpm clean && pnpm build:esm && pnpm build:cjs && pnpm build:docs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "build:bundles": "pnpm clean:bundles && NODE_OPTIONS='--max-old-space-size=4096' tsdown",
    "build:all": "pnpm build && pnpm build:bundles && pnpm sizes",
    "build:docs": "typedoc",
    "format": "npx biome format --write",
    "test": "vitest",
    "sizes": "npx bundle-size",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fimbul-works/nested-path": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@fimbul-works/bundle-size": "^2.0.0",
    "@types/node": "^26.6.4",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
