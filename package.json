{
  "name": "@fimbul-works/finna",
  "description": "An ultra-lightweight, modular, and type-safe pattern matching engine and predicate compiler for JavaScript and TypeScript.",
  "version": "2.0.0",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "FimbulWorks <contact@fimbul.works>",
  "homepage": "https://github.com/fimbul-works/finna#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fimbul-works/finna.git"
  },
  "bugs": {
    "url": "https://github.com/fimbul-works/finna/issues"
  },
  "keywords": [
    "finna",
    "matcher",
    "pattern-matching",
    "predicate",
    "ast-matcher",
    "query",
    "query-engine",
    "filter",
    "mongodb",
    "json-query",
    "compiler",
    "operators",
    "typescript",
    "tree-shakable"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./array": {
      "types": "./dist/esm/operators/array/index.d.ts",
      "import": "./dist/esm/operators/array/index.js",
      "require": "./dist/cjs/operators/array/index.js"
    },
    "./array/*": {
      "types": "./dist/esm/operators/array/*.d.ts",
      "import": "./dist/esm/operators/array/*.js",
      "require": "./dist/cjs/operators/array/*.js"
    },
    "./comparison": {
      "types": "./dist/esm/operators/comparison/index.d.ts",
      "import": "./dist/esm/operators/comparison/index.js",
      "require": "./dist/cjs/operators/comparison/index.js"
    },
    "./comparison/*": {
      "types": "./dist/esm/operators/comparison/*.d.ts",
      "import": "./dist/esm/operators/comparison/*.js",
      "require": "./dist/cjs/operators/comparison/*.js"
    },
    "./date": {
      "types": "./dist/esm/operators/date/index.d.ts",
      "import": "./dist/esm/operators/date/index.js",
      "require": "./dist/cjs/operators/date/index.js"
    },
    "./date/*": {
      "types": "./dist/esm/operators/date/*.d.ts",
      "import": "./dist/esm/operators/date/*.js",
      "require": "./dist/cjs/operators/date/*.js"
    },
    "./element": {
      "types": "./dist/esm/operators/element/index.d.ts",
      "import": "./dist/esm/operators/element/index.js",
      "require": "./dist/cjs/operators/element/index.js"
    },
    "./element/*": {
      "types": "./dist/esm/operators/element/*.d.ts",
      "import": "./dist/esm/operators/element/*.js",
      "require": "./dist/cjs/operators/element/*.js"
    },
    "./equality": {
      "types": "./dist/esm/operators/equality/index.d.ts",
      "import": "./dist/esm/operators/equality/index.js",
      "require": "./dist/cjs/operators/equality/index.js"
    },
    "./equality/*": {
      "types": "./dist/esm/operators/equality/*.d.ts",
      "import": "./dist/esm/operators/equality/*.js",
      "require": "./dist/cjs/operators/equality/*.js"
    },
    "./string": {
      "types": "./dist/esm/operators/string/index.d.ts",
      "import": "./dist/esm/operators/string/index.js",
      "require": "./dist/cjs/operators/string/index.js"
    },
    "./string/*": {
      "types": "./dist/esm/operators/string/*.d.ts",
      "import": "./dist/esm/operators/string/*.js",
      "require": "./dist/cjs/operators/string/*.js"
    },
    "./register-core": {
      "types": "./dist/esm/operators/register-core.d.ts",
      "import": "./dist/esm/operators/register-core.js",
      "require": "./dist/cjs/operators/register-core.js"
    },
    "./register-extended": {
      "types": "./dist/esm/operators/register-extended.d.ts",
      "import": "./dist/esm/operators/register-extended.js",
      "require": "./dist/cjs/operators/register-extended.js"
    },
    "./register-all": {
      "types": "./dist/esm/operators/register-all.d.ts",
      "import": "./dist/esm/operators/register-all.js",
      "require": "./dist/cjs/operators/register-all.js"
    },
    "./field-reference": {
      "types": "./dist/esm/operators/field-reference.d.ts",
      "import": "./dist/esm/operators/field-reference.js",
      "require": "./dist/cjs/operators/field-reference.js"
    },
    "./operator-registry": {
      "types": "./dist/esm/operators/operator-registry.d.ts",
      "import": "./dist/esm/operators/operator-registry.js",
      "require": "./dist/cjs/operators/operator-registry.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "clean:bundles": "rm -rf bundles",
    "build": "pnpm clean && pnpm build:esm && pnpm build:cjs && pnpm build:docs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "build:bundles": "pnpm clean:bundles && NODE_OPTIONS='--max-old-space-size=4096' tsdown",
    "build:all": "pnpm build && pnpm build:bundles && pnpm sizes",
    "build:docs": "typedoc",
    "format": "npx biome format --write",
    "test": "vitest",
    "sizes": "npx bundle-size",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fimbul-works/nested-path": "^2.0.0",
    "@fimbul-works/hvat": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@fimbul-works/bundle-size": "^2.0.0",
    "@types/node": "^26.6.4",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
